RewriteEngine On

# index.php selalu diizinkan
RewriteRule ^index\.php$ - [L]

# Izinkan aset frontend
RewriteCond %{REQUEST_URI} \.(css|js|jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|ttf|otf)$ [NC]
RewriteRule ^ - [L]

# Blok akses langsung ke semua FILE lainnya
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [F,L]
